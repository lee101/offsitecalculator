# app.nz OAuth client id (public PKCE client; no secret). Register one at https://app.nz/developers
APPNZ_CLIENT_ID=offsitecalculator
# 16+ random chars; seals the session cookie. `openssl rand -hex 24`
SESSION_SECRET=
# Optional: Google Maps. Without keys the map falls back to OpenStreetMap and pasted lists use the bundled airport-city gazetteer.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Model the person approves on the app.nz consent screen
OFFSITE_MODEL=gpt-5.5
# Public origin, only needed behind a proxy that does not set X-Forwarded-*
BASE_URL=
